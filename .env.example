# =============================================================================
# shareAi environment template
# Copy to .env.local for development. For production, see docs/DEPLOYMENT.md
# and set these in Vercel (Production) — never commit real secrets.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- App URL (required) ---
# Local: http://localhost:3000
# Prod:  https://your-domain.com  (no trailing slash; must match OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets (required in production; generate unique values per environment) ---
# Base64 string decoding to exactly 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_base64_encoded_32_byte_key
# PROD: set explicitly (do not rely on ENCRYPTION_KEY fallback)
AUTH_SESSION_SECRET=
# PROD: set explicitly (falls back to AUTH_SESSION_SECRET / ENCRYPTION_KEY if empty)
OTP_SECRET=

# --- Intent parsing (recommended) ---
# Free key: aistudio.google.com — if absent, heuristic parser is used.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- OTP email via Resend (required for real login email in production) ---
# Verify your domain in Resend (DKIM/SPF), then use an address on that domain.
# See docs/DEPLOYMENT.md § Resend.
RESEND_API_KEY=
OTP_FROM_EMAIL=noreply@your-domain.com
# Local only: expose OTP in API response when email is not configured (never in production)
# OTP_DEV_EXPOSE=1

# --- OAuth providers (optional per connector; redirects must use NEXT_PUBLIC_APP_URL) ---
# Slack — Redirect URL: ${NEXT_PUBLIC_APP_URL}/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google (Calendar + Gmail) — add BOTH redirect URIs:
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/google-calendar/callback
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/google-gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — Callback: ${NEXT_PUBLIC_APP_URL}/api/oauth/github/callback
# Default scope gist; add repo for issues. See docs/ADDING_CONNECTORS.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# WhatsApp Cloud API — docs/WHATSAPP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Allowlists (MANDATORY in production) ---
# http.request: empty list denies all hosts (safe default). Prod: set explicit hosts.
HTTP_ACTION_ALLOWLIST=
# browser.open_url: empty list allows ANY host in code — MUST set in production.
BROWSER_ACTION_ALLOWLIST=

# --- Browser automation (local / dedicated worker; unreliable on Vercel serverless) ---
# See docs/DEPLOYMENT.md § Playwright. Prefer BROWSER_HEADLESS=true in any shared host.
BROWSER_HEADLESS=true
BROWSER_KEEP_OPEN_MS=0
BROWSER_SLOW_MO_MS=50

# --- OS actions (Windows hosts only; not available on Vercel Linux) ---
OS_ACTION_SANDBOX_ROOT=

# --- v2 orchestration tuning ---
V2_STEP_TIMEOUT_MS=30000
V2_STEP_MAX_RETRIES=1
V2_RUN_RATE_LIMIT_WINDOW_SECONDS=60
V2_RUN_RATE_LIMIT_MAX=20

# --- Scheduled runs (required if using cron worker) ---
# POST /api/internal/run-schedules with Authorization: Bearer <secret>
# Generate 16+ chars. See docs/SCHEDULED_RUNS.md and docs/DEPLOYMENT.md
INTERNAL_CRON_SECRET=

# --- Calendar ---
# IANA timezone when Gemini fallback parses times (e.g. Asia/Kolkata)
CALENDAR_DEFAULT_TIMEZONE=
